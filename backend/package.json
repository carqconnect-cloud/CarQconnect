{
  "name": "@fioner/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fioner API - Express + TypeScript + Prisma",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently --names \"NODE,AI\" --prefix-colors \"cyan,magenta\" \"tsx watch --clear-screen=false src/server.ts\" \"npm run ai:start:optional\"",
    "ai:start:optional": "powershell -NoProfile -Command \"& py -c 'import uvicorn' 2>$null; if ($LASTEXITCODE -eq 0) { npm run ai:start } else { Write-Host 'AI service skipped: Python or uvicorn is not installed.' }\"",
    "ai:start": "powershell -Command \"Set-Location src/AI; py -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "ai:install": "powershell -Command \"Set-Location src/AI; py -m pip install -r requirements.txt\"",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --max-old-space-size=384 dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude=\"**/*.int.test.ts\"",
    "test:integration": "vitest run tests/database.int.test.ts",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm install && docker compose up -d && prisma migrate dev && npm run seed",
    "gen:module": "tsx scripts/generate-module.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.0",
    "prisma": "^6.14.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^2.1.9"
  }
}
