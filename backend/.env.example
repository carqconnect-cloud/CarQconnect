# ===========================================================================
# FIONER BACKEND ENVIRONMENT TEMPLATE (.env.example)
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Production secrets must be injected via the deployment platform (e.g. Render).
# Core startup variables are validated at process initialization in src/config/env.ts.
# ===========================================================================

# ---------------------------------------------------------------------------
# CORE SERVER CONFIGURATION
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL & Prisma)
#
# LOCAL DEVELOPMENT:
#   docker-compose.yml maps container port 5432 to host port 5433 to avoid
#   conflicts with host PostgreSQL instances. Local development uses port 5433:
#   DATABASE_URL="postgresql://fioner:fioner@localhost:5433/fioner?schema=public"
#   DIRECT_URL="postgresql://fioner:fioner@localhost:5433/fioner?schema=public"
#
# RENDER / CLOUD DEPLOYMENT:
#   DATABASE_URL is provided by Render PostgreSQL (pooled connection or internal URL).
#   DIRECT_URL is required by Prisma schema (base.prisma) for migrations when
#   connection poolers (e.g., PgBouncer) are used.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://fioner:fioner@localhost:5433/fioner?schema=public"
DIRECT_URL="postgresql://fioner:fioner@localhost:5433/fioner?schema=public"

# ---------------------------------------------------------------------------
# AUTHENTICATION & JWT SIGNING SECRETS
#
# Requirements:
#   - Minimum 32 characters each.
#   - JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be distinct.
#   - In production (NODE_ENV=production), placeholder values (e.g., containing
#     "change-me", "example", etc.) are strictly rejected at startup.
# Generate high-entropy secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-to-a-long-random-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-long-random-refresh-secret-at-least-32-chars"
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS CONFIGURATION
#
# LOCAL DEVELOPMENT:
#   Comma-delimited origins of local frontend development servers.
#
# PRODUCTION (Render + Vercel):
#   MUST be explicitly configured with exact deployed Vercel frontend origins
#   (e.g., "https://fioner.com,https://admin.fioner.com,https://crm.fioner.com").
#   - Wildcard (*) is forbidden because credentials: true is enabled.
#   - Origins must include scheme and host only (no trailing slashes or subpaths).
#   - In production, localhost origins are rejected.
# ---------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ---------------------------------------------------------------------------
# LOGGING & RATE LIMITING
# ---------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ===========================================================================
# OPTIONAL INTEGRATIONS (Not required for core server startup)
# ===========================================================================

# ---------------------------------------------------------------------------
# REDIS (Optional Cache & Distributed Rate Limiting)
# If omitted, the application operates normally with an in-memory fallback.
# In multi-instance production environments (e.g., scaled Render instances),
# Redis is recommended for shared state across replicas.
# ---------------------------------------------------------------------------
# REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# RAZORPAY (Payments - Required only for checkout order initiation & webhooks)
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID="rzp_test_placeholder"
# RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"
# RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# ---------------------------------------------------------------------------
# EXOTEL (Telephony & Outbound IVR)
# ---------------------------------------------------------------------------
# EXOTEL_API_KEY="placeholder_exotel_key"
# EXOTEL_API_TOKEN="placeholder_exotel_token"
# EXOTEL_SID="placeholder_exotel_sid"
# EXOTEL_TOKEN="placeholder_exotel_token"
# EXOTEL_SUB_DOMAIN="api.exotel.com"

# ---------------------------------------------------------------------------
# MSG91 (SMS & OTP Dispatch)
# ---------------------------------------------------------------------------
# MSG91_AUTH_KEY="placeholder_msg91_auth_key"
# MSG91_API_KEY="placeholder_msg91_api_key"
# MSG91_SENDER_ID="FIONER"
# MSG91_TEMPLATE_ID="placeholder_template_id"

# ---------------------------------------------------------------------------
# SUREPASS & AKRIX (KYC & Identity Verification)
# ---------------------------------------------------------------------------
# SUREPASS_API_KEY="placeholder_surepass_key"
# SUREPASS_TOKEN="placeholder_surepass_token"
# AKRIX_API_KEY="placeholder_akrix_key"

# ---------------------------------------------------------------------------
# GOOGLE CLOUD (Maps Geocoding & Speech-to-Text)
# ---------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY="placeholder_google_maps_key"
# GOOGLE_SPEECH_API_KEY="placeholder_google_speech_key"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ---------------------------------------------------------------------------
# SHIPROCKET (Logistics & Shipping Fulfillment)
# ---------------------------------------------------------------------------
# SHIPROCKET_EMAIL="logistics@example.com"
# SHIPROCKET_PASSWORD="placeholder_shiprocket_password"
# SHIPROCKET_TOKEN="placeholder_shiprocket_token"

# ---------------------------------------------------------------------------
# FIREBASE (Push Notifications)
# ---------------------------------------------------------------------------
# FIREBASE_SERVER_KEY="placeholder_firebase_server_key"
# FIREBASE_PROJECT_ID="placeholder_firebase_project_id"
