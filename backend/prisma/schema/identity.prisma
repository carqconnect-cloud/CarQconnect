// -----------------------------------------------------------------------------
// Identity: who a person is, globally. NOT scoped to an organization.
// Org-specific role/permission lives on Membership (see organization.prisma).
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isSuperAdmin    Boolean   @default(false) // super-admin app only
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  addresses         Address[]
  emergencyContacts EmergencyContact[]
  teamsHeaded       Team[]            @relation("TeamHead")
  sosEvents         SosEvent[]
  resolvedSosEvents SosEvent[]        @relation("SosResolvedBy")
  sosTimelineItems  SosTimelineItem[]
  vehicles          Vehicle[]
  qrCodes           QrCode[]
  documents         Document[]
  notifications     Notification[]
  reminders         Reminder[]
  qrHistory         QrAssignmentHistory[]
  gpsHistory        GPSDeviceHistory[]
  storeOrders       StoreOrder[] @relation("StoreOrders")
  subscription      UserSubscription?
  trips             Trip[]
  supportTickets         SupportTicket[]       @relation("UserSupportTickets")
  assignedSupportTickets SupportTicket[]       @relation("AssignedSupportTickets")

  @@index([isActive])
  @@map("users")
}

model SuperAdmin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  subAdmins     SubSuperAdmin[]
  refreshTokens RefreshToken[]

  @@index([isActive])
  @@map("super_admins")
}

model SubSuperAdmin {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  roleTitle    String         @default("Sub-Super Admin")
  permissions  Json?
  isActive     Boolean        @default(true)
  createdById  String
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy     SuperAdmin     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([createdById])
  @@index([isActive])
  @@map("sub_super_admins")
}

/// One row per active login session. Rotated on every refresh.
model RefreshToken {
  id              String         @id @default(cuid())
  userId          String?
  crmUserId       String?
  superAdminId    String?
  subSuperAdminId String?
  tokenHash       String         @unique
  organizationId  String?
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?
  createdAt       DateTime       @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmUser       CrmUser?       @relation(fields: [crmUserId], references: [id], onDelete: Cascade)
  superAdmin    SuperAdmin?    @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  subSuperAdmin SubSuperAdmin? @relation(fields: [subSuperAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([crmUserId])
  @@index([superAdminId])
  @@index([subSuperAdminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  type      String
  address   String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeOrders StoreOrder[] @relation("StoreAddressOrders")

  @@index([userId])
  @@map("addresses")
}

model EmergencyContact {
  id             String   @id @default(cuid())
  userId         String
  name           String
  phone          String
  initials       String
  isPrimary      Boolean  @default(false)
  email          String?
  relationship   String?
  sendSmsGps     Boolean  @default(true)
  shareTelemetry Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}
