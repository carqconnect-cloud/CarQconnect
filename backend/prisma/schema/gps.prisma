// -----------------------------------------------------------------------------
// GPS Domain (GPS Device Management & Telematics Inventory)
// SOW v1.0 Section 3, 4, 8.3; PRD v1.0 Section 16, 19, 23, 24
// -----------------------------------------------------------------------------

enum GpsDeviceStatus {
  UNASSIGNED
  ACTIVE
  MAINTENANCE
  DEACTIVATED
}

model GPSDevice {
  id             String          @id @default(cuid())
  imei           String          @unique
  serialNumber   String?         @unique
  model          String?
  vendor         String?
  status         GpsDeviceStatus @default(UNASSIGNED)
  vehicleId      String?         @unique
  batteryLevel   Int?
  signalStrength String?
  lastSeenAt     DateTime?
  lastLatitude   Float?
  lastLongitude  Float?
  speed          Float?
  heading        Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  vehicle Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  history GPSDeviceHistory[]

  @@index([imei])
  @@index([serialNumber])
  @@index([status])
  @@index([createdAt])
  @@map("gps_devices")
}

model GPSDeviceHistory {
  id           String    @id @default(cuid())
  deviceId     String?
  deviceImei   String
  vehicleId    String?
  vehicleReg   String?
  userId       String?
  userEmail    String?
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?
  notes        String?
  createdAt    DateTime  @default(now())

  device  GPSDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vehicle Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([deviceImei])
  @@index([vehicleId])
  @@index([vehicleReg])
  @@index([userId])
  @@index([assignedAt])
  @@map("gps_device_history")
}

model Geofence {
  id           String   @id @default(cuid())
  vehicleId    String
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([isActive])
  @@map("geofences")
}
