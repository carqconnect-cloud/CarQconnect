// -----------------------------------------------------------------------------
// QR Domain (QR Code Management & Public Interaction)
// SOW v1.0 Section 3, 4, 8.2; PRD v1.0 Section 6, 19, 22, 23, 24
// -----------------------------------------------------------------------------

enum QrStatus {
  AVAILABLE
  ASSIGNED
  ACTIVE
  SUSPENDED
  REPLACED
  DEACTIVATED
}

model QrCode {
  id                   String   @id @default(cuid())
  code                 String   @unique
  batch                String   @default("DEFAULT")
  status               QrStatus @default(AVAILABLE)
  vehicleId            String?  @unique
  userId               String?
  // Mobile App privacy & settings
  callOwner            Boolean  @default(false)
  sendMessage          Boolean  @default(false)
  bloodGroupVisibility Boolean  @default(false)
  emergencyContact     Boolean  @default(false)
  isActive             Boolean  @default(true)
  scansCount           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  history  QrAssignmentHistory[]
  scanLogs QrScanLog[]

  @@index([code])
  @@index([batch])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("qr_codes")
}

model QrAssignmentHistory {
  id           String    @id @default(cuid())
  qrCodeId     String?
  qrCodeValue  String
  vehicleId    String?
  vehicleReg   String?
  userId       String?
  userEmail    String?
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?
  notes        String?
  createdAt    DateTime  @default(now())

  qrCode  QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([qrCodeValue])
  @@index([vehicleId])
  @@index([vehicleReg])
  @@index([userId])
  @@index([assignedAt])
  @@map("qr_assignment_history")
}

model QrScanLog {
  id          String   @id @default(cuid())
  qrCodeId    String?
  qrCodeValue String
  scannedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  city        String?
  actionTaken String?
  metadata    Json?

  qrCode QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([qrCodeValue])
  @@index([scannedAt])
  @@map("qr_scan_logs")
}
