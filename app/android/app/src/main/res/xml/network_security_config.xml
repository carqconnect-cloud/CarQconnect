<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Allow cleartext traffic so dev backends, local IPs, and HTTP APIs work seamlessly across release and debug builds -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

